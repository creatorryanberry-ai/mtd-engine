# Production Environment Variables
# Copy this file to .env.production and fill in the actual values
# Run: cp .env.production.example .env.production

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Platform: "uncloud" or "sst"
DEPLOYMENT_PLATFORM=uncloud

# Docker build architecture: "linux/amd64" or "linux/arm64"
DEPLOYMENT_ARCH=linux/amd64

# Server Configuration (for uncloud)
DEPLOY_HOST=your-server-ip
DEPLOY_USER=your-ssh-user
DEPLOY_SSH_KEY=~/.ssh/uncloud_deploy

# ============================================================================
# APPLICATION URLs (api-first; web vars only when shipping web)
# ============================================================================

# Standalone api host — native app + better-auth live here
API_SERVER_URL=https://api.straightup.tax
VITE_API_HOSTNAME=api.straightup.tax
BETTER_AUTH_URL=https://api.straightup.tax
VITE_PROTOCOL=https

# Required for deploy-web / `bun tko release … --web` (leave unset for api-only):
# ONE_SERVER_URL=https://app.straightup.tax
# VITE_WEB_HOSTNAME=app.straightup.tax

# HMRC callback on the api host
HMRC_REDIRECT_URI=https://api.straightup.tax/api/hmrc/callback
HMRC_NATIVE_REDIRECT_URI=straightuptax://hmrc/callback

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Main database connection (used for migrations and runtime)
DEPLOY_DB=postgresql://user:password@host:5432/straightuptax?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/straightuptax?sslmode=require

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-secret-key-here

# Public OTP sign-in (leave unset until launch; set to 1 when opening product login).
# ALLOW_PUBLIC_AUTH=
# VITE_ALLOW_PUBLIC_AUTH=

# NEVER enable demo flags in production — deploy/boot will fail.
# ALLOW_DEMO_AUTH=
# VITE_DEMO_MODE=

# Social login (native OAuth via better-auth). Optional until credentials exist.
# Callbacks: https://api.straightup.tax/api/auth/callback/google
#            https://api.straightup.tax/api/auth/callback/apple
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# GitHub OAuth (optional)
# ONECHAT_GITHUB_CLIENT_ID=your-github-client-id
# ONECHAT_GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================================
# STORAGE (Google Cloud — private receipts)
# ============================================================================
# Local dev uses MinIO automatically (see src/env.ts development defaults).
# Staging/production use GCS only.

GCS_RECEIPTS_BUCKET=straightuptax-receipts
# GCS_PROJECT_ID=   # optional if present in the service account JSON
GCS_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional extra admin emails (comma-separated) in addition to user.role=admin
# ADMIN_EMAILS=ops@straightup.tax

# ============================================================================
# PUSH NOTIFICATIONS (Apple)
# ============================================================================

# APNS_ENDPOINT=https://api.push.apple.com
# APNS_TEAM_ID=your-team-id
# APNS_KEY_ID=your-key-id
# APNS_KEY=your-apns-key

# ============================================================================
# TRANSACTION SYNC WINDOW
# ============================================================================

TRANSACTION_WINDOW_DAYS=90

# ============================================================================
# EMAIL (Postmark)
# ============================================================================

POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_FROM_EMAIL=hello@straightup.tax
INBOUND_EMAIL_DOMAIN=inbox.straightup.tax
POSTMARK_INBOUND_WEBHOOK_USER=postmark
POSTMARK_INBOUND_WEBHOOK_PASSWORD=your-inbound-webhook-password

# ============================================================================
# ANALYTICS (PostHog)
# ============================================================================

# VITE_POSTHOG_API_KEY=your-posthog-key
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# ============================================================================
# AWS (for SST deployment only)
# ============================================================================

# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-west-1

# ============================================================================
# CLOUDFLARE ORIGIN CA (optional)
# ============================================================================

# For Uncloud - Use Origin CA instead of Let's Encrypt for custom domains
# Benefits: bypass rate limits, enable Cloudflare proxy (DDoS protection)
# Generate at: Cloudflare Dashboard → SSL/TLS → Origin Server
# ORIGIN_CA_CERT=src/uncloud/certs/origin.pem
# ORIGIN_CA_KEY=src/uncloud/certs/origin.key

# ============================================================================
# UNCLOUD TEAM SHARING (optional)
# ============================================================================

# Encrypt cluster config for team sharing
# UNCLOUD_CLUSTER_PASSWORD=your-secure-password
