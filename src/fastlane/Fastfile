# local store releases via bun tko release — ci (native-cd) deferred

default_platform(:ios)

require "base64"
require "fileutils"

def require_env!(key)
  value = ENV[key].to_s
  UI.user_error!("#{key} is required") if value.empty?
  value
end

def match_git_url
  require_env!("APPLE_CODE_SIGNING_GIT_URL")
end

def apple_team_id
  require_env!("APPLE_DEVELOPER_TEAM_ID")
end

def ios_bundle_id
  require_env!("IOS_BUNDLE_ID")
end

def ios_app_identifiers
  ids = [ios_bundle_id]
  ext = ENV["IOS_EXTENSION_BUNDLE_ID"].to_s
  ids << ext unless ext.empty?
  ids
end

def asc_api_key
  # altool looks for AuthKey_<id>.p8 here — without it, upload asks for
  # an app-specific password even when Spaceship login succeeded
  install_asc_api_key_for_altool!
  app_store_connect_api_key(
    key_id: require_env!("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: require_env!("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
    key_content: require_env!("APP_STORE_CONNECT_API_KEY_P8"),
    is_key_content_base64: false
  )
end

def install_asc_api_key_for_altool!
  key_id = require_env!("APP_STORE_CONNECT_API_KEY_ID")
  key_content = require_env!("APP_STORE_CONNECT_API_KEY_P8")
  dir = File.expand_path("~/.appstoreconnect/private_keys")
  FileUtils.mkdir_p(dir)
  path = File.join(dir, "AuthKey_#{key_id}.p8")
  File.write(path, key_content)
  File.chmod(0o600, path)
  ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] ||= key_id
  ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] ||= require_env!("APP_STORE_CONNECT_API_KEY_ISSUER_ID")
  ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"] ||= path
end

def ios_workspace
  ENV["IOS_WORKSPACE"].to_s.empty? ? nil : ENV["IOS_WORKSPACE"]
end

def ios_scheme
  require_env!("IOS_SCHEME")
end

def skip_upload?
  ENV["SKIP_UPLOAD"].to_s == "1" || ENV["SKIP_UPLOAD"].to_s.downcase == "true"
end

# next_build_number / next_version_code lanes hand their result back to
# scripts/release via this file (parsing fastlane stdout is fragile)
def write_number_file!(value)
  path = ENV["BUILD_NUMBER_FILE"].to_s
  UI.user_error!("BUILD_NUMBER_FILE not set") if path.empty?
  File.write(path, value.to_s)
end

def prepare_android_keystore!
  path = ENV["ANDROID_KEYSTORE_PATH"].to_s
  return path unless path.empty?

  b64 = ENV["ANDROID_KEYSTORE_BASE64"].to_s
  UI.user_error!("Set ANDROID_KEYSTORE_PATH or ANDROID_KEYSTORE_BASE64") if b64.empty?

  out = File.join(Dir.tmpdir, "mtd-release-#{Process.pid}.jks")
  File.binwrite(out, Base64.decode64(b64))
  at_exit { FileUtils.rm_f(out) }
  out
end

def play_json_key_path
  path = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH"].to_s
  return path unless path.empty?

  json = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"].to_s
  UI.user_error!("Set GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH or GOOGLE_PLAY_SERVICE_ACCOUNT_JSON") if json.empty?

  out = File.join(Dir.tmpdir, "mtd-play-#{Process.pid}.json")
  File.write(out, json)
  at_exit { FileUtils.rm_f(out) }
  out
end

platform :ios do
  before_all do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "120"
  end

  desc "Check bundle ID and app record"
  lane :check_app do
    api_key = asc_api_key

    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    bundle_id = Spaceship::ConnectAPI::BundleId.find(ios_bundle_id, includes: nil)
    if bundle_id
      UI.success("Bundle ID #{ios_bundle_id} exists")
    else
      UI.error("Bundle ID #{ios_bundle_id} not found")
    end

    app = Spaceship::ConnectAPI::App.find(ios_bundle_id)
    if app
      UI.success("App record exists: #{app.name} (#{app.bundle_id})")
    else
      UI.message("App record not found - will be created on first upload")
    end
  end

  # match auto-reads MATCH_FORCE as a string and rejects it — strip before calling
  def match_force_regen?
    force = ENV.delete("MATCH_FORCE").to_s == "1" ||
            ENV.delete("REGENERATE_PROFILES").to_s == "1"
    force
  end

  desc "Setup certificates and profiles (readonly)"
  lane :setup_certs do
    asc_api_key
    ENV.delete("MATCH_FORCE")
    match(
      type: "appstore",
      app_identifier: ios_app_identifiers,
      team_id: apple_team_id,
      git_url: match_git_url,
      git_branch: "match",
      readonly: true,
      force: false,
      force_legacy_encryption: true
    )
  end

  desc "Create/sync certificates and profiles (writes to match repo)"
  lane :sync_certs do
    asc_api_key
    force = match_force_regen?
    match(
      type: "appstore",
      app_identifier: ios_app_identifiers,
      team_id: apple_team_id,
      git_url: match_git_url,
      git_branch: "match",
      readonly: false,
      force: force,
      force_legacy_encryption: true
    )
  end

  desc "Query TestFlight for the next build number (latest + 1)"
  lane :next_build_number do
    latest = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: ios_bundle_id,
      # no builds yet → latest 0 → next 1
      initial_build_number: 0
    )
    UI.success("TestFlight latest build: #{latest} → next: #{latest + 1}")
    write_number_file!(latest.to_i + 1)
  end

  desc "Archive iOS app (App Store signing)"
  lane :build do
    asc_api_key
    setup_certs

    project_root = ENV["REPO_ROOT"] || File.expand_path("../..", __dir__)
    xcodeproj = File.join(project_root, "ios", "#{ios_scheme}.xcodeproj")
    mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}

    UI.user_error!("Missing xcodeproj at #{xcodeproj}") unless File.directory?(xcodeproj)

    update_code_signing_settings(
      path: xcodeproj,
      use_automatic_signing: false,
      team_id: apple_team_id,
      targets: [ios_scheme],
      code_sign_identity: "iPhone Distribution",
      profile_name: mapping[ios_bundle_id],
      bundle_identifier: ios_bundle_id
    )

    extension_id = ENV["IOS_EXTENSION_BUNDLE_ID"].to_s
    extension_target = "#{ios_scheme}LiveActivity"
    if !extension_id.empty? && mapping[extension_id]
      update_code_signing_settings(
        path: xcodeproj,
        use_automatic_signing: false,
        team_id: apple_team_id,
        targets: [extension_target],
        code_sign_identity: "iPhone Distribution",
        profile_name: mapping[extension_id],
        bundle_identifier: extension_id
      )
    end

    # apply the store-derived build number directly to the plists so it also
    # holds for --skip-prebuild runs (prebuild bakes it via app.config.ts).
    # the extension's CFBundleVersion must match the app's or apple rejects.
    build_number = ENV["IOS_BUILD_NUMBER"].to_s
    unless build_number.empty?
      [ios_scheme, extension_target].each do |target|
        plist = File.join(project_root, "ios", target, "Info.plist")
        next unless File.exist?(plist)

        set_info_plist_value(path: plist, key: "CFBundleVersion", value: build_number)
        UI.message("#{target} CFBundleVersion → #{build_number}")
      end
    end

    # plain xcbeautify prints Compiling/Linking lines so the archive doesn't look hung
    # after Clean Succeeded (--quieter hides that). full log: ~/Library/Logs/gym
    formatter =
      if system("command -v xcbeautify >/dev/null 2>&1")
        "xcbeautify"
      else
        "xcpretty"
      end

    gym_args = {
      scheme: ios_scheme,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: File.join(project_root, "build", "ios"),
      output_name: "#{ios_scheme}.ipa",
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{apple_team_id}",
      suppress_xcode_output: false,
      xcodebuild_formatter: formatter
    }
    gym_args[:workspace] = ios_workspace if ios_workspace

    gym(gym_args)
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    build

    if skip_upload?
      UI.important("SKIP_UPLOAD set — skipping TestFlight upload")
      next
    end

    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: ios_bundle_id,
      # wait until apple finishes processing so success = build usable in TestFlight
      skip_waiting_for_build_processing: false
    )
  end

  desc "Upload an already-built ipa to TestFlight (after a --skip-upload build)"
  lane :upload do
    project_root = ENV["REPO_ROOT"] || File.expand_path("../..", __dir__)
    ipa = ENV["IPA_PATH"].to_s
    ipa = File.join(project_root, "build", "ios", "#{ios_scheme}.ipa") if ipa.empty?
    UI.user_error!("ipa not found at #{ipa} — build first with bun tko release") unless File.exist?(ipa)

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa,
      app_identifier: ios_bundle_id,
      # wait until apple finishes processing so success = build usable in TestFlight
      skip_waiting_for_build_processing: false
    )
  end
end

platform :android do
  desc "Query Play for the next version code (max across tracks + 1)"
  lane :next_version_code do
    package = require_env!("ANDROID_PACKAGE_NAME")
    json_key = play_json_key_path
    tracks = ["internal", "alpha", "beta", "production"]
    codes = []
    errors = []
    tracks.each do |track|
      codes.concat(
        google_play_track_version_codes(
          track: track,
          package_name: package,
          json_key: json_key
        )
      )
    rescue StandardError => e
      errors << "#{track}: #{e.message.to_s.lines.first&.strip}"
    end

    # every track erroring means auth/app lookup is broken — abort, never guess
    if codes.empty? && errors.length == tracks.length
      UI.user_error!("could not read version codes from Play:\n  #{errors.join("\n  ")}")
    end

    latest = codes.max || 0
    UI.success("Play latest version code: #{latest} → next: #{latest + 1}")
    write_number_file!(latest + 1)
  end

  desc "Build release AAB"
  lane :build do
    keystore = prepare_android_keystore!
    project_dir = ENV["ANDROID_PROJECT_DIR"] || File.join(Dir.pwd, "android")

    # apply the store-derived version code directly so it also holds for
    # --skip-prebuild runs (prebuild bakes it via app.config.ts)
    version_code = ENV["ANDROID_VERSION_CODE"].to_s
    unless version_code.empty?
      gradle_file = File.join(project_dir, "app", "build.gradle")
      if File.exist?(gradle_file)
        content = File.read(gradle_file)
        File.write(gradle_file, content.sub(/versionCode \d+/, "versionCode #{version_code}"))
        UI.message("versionCode → #{version_code}")
      end
    end

    # skip emulator abis — halves native cmake time; play devices are arm*
    arches = ENV["REACT_NATIVE_ARCHITECTURES"].to_s
    arches = "armeabi-v7a,arm64-v8a" if arches.empty?

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: project_dir,
      flags: "--no-daemon",
      properties: {
        "android.injected.signing.store.file" => keystore,
        "android.injected.signing.store.password" => require_env!("ANDROID_KEYSTORE_PASSWORD"),
        "android.injected.signing.key.alias" => require_env!("ANDROID_KEY_ALIAS"),
        "android.injected.signing.key.password" => require_env!("ANDROID_KEY_PASSWORD"),
        "reactNativeArchitectures" => arches
      }
    )
  end

  desc "Build and upload to Play Console"
  lane :beta do
    build

    if skip_upload?
      UI.important("SKIP_UPLOAD set — skipping Play Store upload")
      next
    end

    upload
  end

  desc "Upload an already-built aab to Play Console (after a --skip-upload build)"
  lane :upload do
    project_root = ENV["REPO_ROOT"] || File.expand_path("../..", __dir__)
    aab = ENV["AAB_PATH"].to_s
    if aab.empty?
      aab = File.join(project_root, "android", "app", "build", "outputs", "bundle", "release", "app-release.aab")
    end
    UI.user_error!("aab not found at #{aab} — build first with bun tko release") unless File.exist?(aab)

    track = ENV["PLAY_TRACK"] || "internal"
    release_status = ENV["PLAY_RELEASE_STATUS"] || (track == "production" ? "draft" : "completed")

    upload_to_play_store(
      track: track,
      release_status: release_status,
      aab: aab,
      json_key: play_json_key_path,
      package_name: require_env!("ANDROID_PACKAGE_NAME"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end
