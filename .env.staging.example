# Staging Environment Variables
# Copy to .env.staging and fill in real values. .env.staging is gitignored.
# Staging runs in production MODE with staging VALUES on isolated infra.
# Staging ships the standalone api ONLY (no web app) at staging-api.straightup.tax.

# ---- deployment target (separate VM from prod) ----
DEPLOYMENT_PLATFORM=uncloud
DEPLOYMENT_ARCH=linux/amd64
DEPLOY_HOST=your-staging-vm-ip
DEPLOY_USER=your-ssh-user
DEPLOY_SSH_KEY=~/.ssh/uncloud_deploy
UNCLOUD_CONTEXT=staging

# ---- app/api urls (staging: api-first; web vars only when shipping web) ----
API_SERVER_URL=https://staging-api.straightup.tax
VITE_API_HOSTNAME=staging-api.straightup.tax
BETTER_AUTH_URL=https://staging-api.straightup.tax
VITE_PROTOCOL=https
ENABLE_API_DOCS=1
# Required for deploy-web --staging / `bun tko release preview --web`:
# ONE_SERVER_URL=https://staging-api.straightup.tax
# VITE_WEB_HOSTNAME=staging-api.straightup.tax

# ---- database (separate managed postgres instance — not the production host) ----
DEPLOY_DB=postgresql://USER:PASSWORD@STAGING_DB_HOST:5432/straightuptax?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_DB_HOST:5432/straightuptax?sslmode=require

# ---- auth (generate a fresh secret, DO NOT reuse prod) ----
# openssl rand -hex 32
BETTER_AUTH_SECRET=generate-a-new-32-byte-hex-secret
# staging must allow sign-in (prod leaves these empty/off). ALLOW_* is server-side;
# VITE_* is baked into the preview app so login UI is shown.
ALLOW_PUBLIC_AUTH=1
ALLOW_DEMO_AUTH=
VITE_ALLOW_PUBLIC_AUTH=1
VITE_DEMO_MODE=

# Social login (native OAuth via better-auth). Optional until credentials exist.
# Callbacks: https://staging-api.straightup.tax/api/auth/callback/google
#            https://staging-api.straightup.tax/api/auth/callback/apple
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# ---- integrations point at the api host (sandbox, same as prod) ----
HMRC_ENV=sandbox
HMRC_CLIENT_ID=your-hmrc-sandbox-client-id
HMRC_CLIENT_SECRET=your-hmrc-sandbox-client-secret
HMRC_REDIRECT_URI=https://staging-api.straightup.tax/api/hmrc/callback
HMRC_NATIVE_REDIRECT_URI=straightuptax://hmrc/callback
HMRC_ACCOUNT_URL=https://www.tax.service.gov.uk/account
TRANSACTION_WINDOW_DAYS=90

# ---- email ----
POSTMARK_SERVER_TOKEN=your-postmark-token
POSTMARK_FROM_EMAIL=hello@straightup.tax
INBOUND_EMAIL_DOMAIN=inbox.straightup.tax
POSTMARK_INBOUND_WEBHOOK_USER=postmark
POSTMARK_INBOUND_WEBHOOK_PASSWORD=your-inbound-webhook-password

# ---- storage (GCS for private receipts — required for TestFlight/preview uploads) ----
# Local dev uses MinIO automatically; staging uses GCS only.
GCS_RECEIPTS_BUCKET=straightuptax-receipts-staging
# GCS_PROJECT_ID=   # optional if present in the service account JSON
GCS_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---- tls (optional origin ca; otherwise caddy uses lets-encrypt) ----
# ORIGIN_CA_CERT=src/uncloud/certs/origin.pem
# ORIGIN_CA_KEY=src/uncloud/certs/origin.key
